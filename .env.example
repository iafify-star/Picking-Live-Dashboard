# ─────────────────────────────────────────────────────────────
# Picking Live Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────

# Google Sheets — Picking sheet
# The spreadsheet ID (found in the URL of the Google Sheet)
PICK_SHEET_ID=1l6EwjL3i0eNy3mdYlcUcOF8un1-31ycKJEL5cuZ9MkQ

# The GID of the specific tab/sheet inside the spreadsheet
PICK_GID=841809744

# Fallback: published CSV URL (if the private export fails)
# Generate from: File → Share → Publish to web → CSV
PICK_PUBLISH_URL=

# Google Sheets — HR / Names sheet (for resolving employee names)
NAMES_SHEET_ID=1GaMh4GIfanzEvJYpbtvuVLpawERz_-kRzSrWyqovpXs

# ─────────────────────────────────────────────────────────────
# Local server (server.ps1 only — not used on Vercel)
# ─────────────────────────────────────────────────────────────
PORT=5500
